{
  "name": "vitalis-client",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build:scss": "sass src/scss:src/css",
    "dist-win": "electron-builder --win",
    "dist-linux": "electron-builder --linux",
    "watch:scss": "sass --watch src/scss:src/css"
  },
  "author": "yma <yma@gmail.com>",
  "license": "ISC",
  "homepage": "https://github.com/yourmomahegao/vitalis-client",
  "description": "",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "electron-reloader": "^1.2.3",
    "sass": "^1.94.2"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "jquery": "^3.7.1",
    "sharp": "^0.35.3"
  },
  "build": {
    "productName": "Vitalis Client",
    "appId": "org.erb.vitalisclient",
    "asar": true,
    "asarUnpack": [],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "src/assets/icons/app/vitalis-client-solid-256.png",
      "category": "Development"
    },
    "win": {
      "requestedExecutionLevel": "highestAvailable",
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icons/app/vitalis-client-solid-256.png"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "src/assets/icons/app/vitalis-client-solid-256.ico",
      "uninstallerIcon": "src/assets/icons/app/vitalis-client-solid-256.ico",
      "uninstallDisplayName": "Vitalis Client Uninstaller",
      "allowToChangeInstallationDirectory": false
    }
  }
}
